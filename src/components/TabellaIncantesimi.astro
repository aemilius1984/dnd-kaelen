---
import type { Incantesimo } from '@/lib/schema';

interface Props {
  incantesimi: (Incantesimo & { slug: string; testo: string })[];
  titolo: string;
  /** Se presente, ogni blocco porta `data-slug` e parte nascosto a meno che
   *  lo slug non sia in questo elenco: è così che i 26 incantesimi del pool
   *  possono essere tutti presenti in HTML in build (regole comprese) mentre
   *  un'isola mostra solo quelli davvero preparati — vedi Fix 2 del rapporto.
   *  Quando omesso il blocco è sempre visibile, invariato rispetto a prima. */
  visibiliDiDefault?: string[];
}
const { incantesimi, titolo, visibiliDiDefault } = Astro.props;
---

<h3>{titolo}</h3>
{
  incantesimi.map((m) => (
    <div
      class="magia"
      data-slug={visibiliDiDefault ? m.slug : undefined}
      hidden={visibiliDiDefault ? !visibiliDiDefault.includes(m.slug) : undefined}
    >
      <div class="riga">
        <strong>{m.nome}</strong>
        <span class="tenue">{m.livello === 0 ? 'trucchetto' : `liv. ${m.livello}`}</span>
      </div>
      <div class="tenue meta">
        {m.lancio} · {m.gittata} · {m.componenti}
        {m.concentrazione && ' · concentrazione'}
        {m.tiro && ` · TS ${m.tiro}`}
        {m.danno && ` · ${m.danno}`}
      </div>
      <p>{m.testo}</p>
      {m.slotSuperiore && <p class="tenue">Slot superiore: {m.slotSuperiore}</p>}
    </div>
  ))
}

<style>
  .magia {
    border-top: 1px solid var(--bordo);
    padding: 0.6rem 0;
  }
  .riga {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .meta {
    font-size: 0.85rem;
  }
  p {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
  }
</style>
