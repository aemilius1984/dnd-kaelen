---
interface Props {
  attiva: 'scheda' | 'tattiche' | 'background';
}
const { attiva } = Astro.props;
const voci = [
  { id: 'scheda', href: '/', testo: 'Scheda' },
  { id: 'tattiche', href: '/tattiche/', testo: 'Tattiche' },
  { id: 'background', href: '/background/', testo: 'Background' },
] as const;
---

<nav class="tabbar">
  {
    voci.map((v) => (
      <a href={v.href} aria-current={attiva === v.id ? 'page' : undefined}>
        {v.testo}
      </a>
    ))
  }
</nav>

<style>
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--superficie);
    border-top: 1px solid var(--bordo);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar a {
    padding: 0.85rem 0;
    text-align: center;
    color: var(--testo-tenue);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .tabbar a[aria-current='page'] {
    color: var(--bronzo);
    font-weight: 600;
  }
</style>
