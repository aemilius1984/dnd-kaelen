---
import AzioniMenu from '@/islands/AzioniMenu';
import { SCHEMA_VERSION } from '@/lib/sheet-state';

interface Props {
  attiva: 'scheda' | 'personaggio' | 'storia' | 'preparati' | 'note' | null;
}
const { attiva } = Astro.props;

/* Le due che si aprono a un pollice senza passare dalla tendina. La casa sta
 * fuori da questo elenco perché è un disegno, non una parola: vive da sé, a
 * sinistra. `/` è la splash e non ha `attiva`, quindi la casa non si marca mai
 * come corrente — nessuna pagina che mostra questa barra è la home. */
const scorciatoie = [
  { id: 'scheda', href: '/scheda/', testo: 'Scheda' },
  { id: 'storia', href: '/storia/', testo: 'Storia' },
] as const;

const voci = [
  { id: 'scheda', href: '/scheda/', testo: 'Scheda' },
  { id: 'personaggio', href: '/personaggio/', testo: 'Personaggio' },
  { id: 'storia', href: '/storia/', testo: 'Storia' },
  { id: 'preparati', href: '/preparati/', testo: 'Preparati' },
  { id: 'note', href: '/note/', testo: 'Note' },
] as const;
---

<header class="barra">
  <a class="casa" href="/" aria-label="Home">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M3.5 10.6 12 4l8.5 6.6M6 9.4V19h12V9.4M10 19v-5h4v5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <nav class="scorciatoie" aria-label="Scorciatoie">
    {
      scorciatoie.map((s, i) => (
        <a
          href={s.href}
          style={`--r: ${i + 1}`}
          aria-current={attiva === s.id ? 'page' : undefined}
        >
          {s.testo}
        </a>
      ))
    }
  </nav>

  <details class="menu">
    <summary>
      <span class="barre" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="etichetta apri">Apri il menu</span>
      <span class="etichetta chiudi">Chiudi il menu</span>
    </summary>

    <div class="tendina">
      <div class="rullo">
        <nav aria-label="Pagine">
          <ol>
            {
              voci.map((v, i) => (
                <li style={`--r: ${i}`}>
                  <a href={v.href} aria-current={attiva === v.id ? 'page' : undefined}>
                    <span class="finestra">
                      <span class="parola">{v.testo}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="filetto" aria-hidden="true"></div>

        <div class="coda">
          <p class="colofone">Kaelen · schema v{SCHEMA_VERSION}</p>
          <AzioniMenu client:idle />
        </div>
      </div>
    </div>
  </details>
</header>

<div class="velo" aria-hidden="true"></div>

<script>
  import { creaBarra } from '@/lib/barra-scroll';

  const barra = document.querySelector<HTMLElement>('.barra');
  const menu = barra?.querySelector<HTMLDetailsElement>('details.menu');

  if (barra && menu) {
    const comando = creaBarra({
      leggiY: () => window.scrollY,
      aperto: () => menu.open,
      applica: (nascosta) => barra.toggleAttribute('data-nascosta', nascosta),
      chiudi: () => {
        menu.open = false;
      },
    });

    // Lo scroll arriva molte volte per frame: senza questa riduzione la
    // decisione girerebbe su ogni evento invece che su ogni disegno.
    let inAttesa = false;
    window.addEventListener(
      'scroll',
      () => {
        if (inAttesa) return;
        inAttesa = true;
        window.requestAnimationFrame(() => {
          inAttesa = false;
          comando.scorri();
        });
      },
      { passive: true },
    );

    window.addEventListener('keydown', (e) => comando.tasto(e.key));
    document.addEventListener('pointerdown', (e) =>
      comando.tocco(barra.contains(e.target as Node)),
    );
    menu.addEventListener('toggle', () => {
      if (menu.open) comando.apertura();
    });
  }
</script>

<style>
  /* La barra è vetro fisso in cima: si toglie di mezzo mentre si legge
   * scendendo e torna appena si risale. La direzione dello scroll il CSS non
   * la sa leggere — quel pezzo sta in `src/lib/barra-scroll.ts` e arriva qui
   * come solo attributo `data-nascosta`. */
  .barra {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    /* Tre colonne invece di `space-between`: le due parole devono stare al
     * centro dello schermo, non a metà dello spazio che avanza fra la casa e
     * la ☰ — che sono larghe diverse, quindi le sposterebbero fuori asse. Le
     * due colonne laterali a `1fr` si equilibrano da sole. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spazio-2);
    /* Tacca compresa: il vetro sfocato copre anche la striscia dello
     * schermo che il telefono si tiene, e l'imbottitura riporta le tre
     * colonne sotto di essa. `[data-nascosta]` continua a valere senza
     * modifiche — la percentuale segue l'altezza nuova. */
    height: var(--cappello);
    padding-top: var(--tacca);
    padding-inline: var(--spazio-2);
    border-bottom: 1px solid var(--filetto);
    background: color-mix(in srgb, var(--carta) 55%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    transition:
      transform 0.5s var(--espo),
      background-color 0.4s var(--espo);
  }
  /* Dove il vetro non c'è, il fondo quasi pieno: mezzo velo su un testo che
   * ci scorre sotto sarebbe illeggibile, non trasparente. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .barra {
      background: color-mix(in srgb, var(--carta) 94%, transparent);
    }
  }
  .barra[data-nascosta] {
    transform: translateY(-100%);
  }
  /* A tendina aperta la barra resta, e il vetro diventa carta piena: sotto
   * ci pende un foglio opaco, e due opacità diverse attaccate si vedono. */
  .barra:has(.menu[open]) {
    transform: translateY(0);
    background: var(--carta);
  }

  .casa {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    width: 44px;
    height: 44px;
    margin-left: -0.6rem;
    overflow: hidden;
    color: var(--inchiostro-tenue);
  }
  .casa svg {
    width: 22px;
    height: 22px;
    transition:
      transform 0.5s var(--espo),
      opacity 0.5s var(--espo);
  }

  .scorciatoie {
    display: flex;
    justify-self: center;
    gap: var(--spazio-3);
    overflow: hidden;
  }
  .scorciatoie a {
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--inchiostro-tenue);
    transition:
      transform 0.5s var(--espo),
      opacity 0.5s var(--espo);
  }
  .scorciatoie a[aria-current='page'] {
    color: var(--ambra);
  }
  /* Aperta la tendina, la barra mostra solo l'apertura e la chiusura: le
   * scorciatoie escono dall'alto, sfalsate, e la ☰ resta sola. */
  .barra:has(.menu[open]) .casa svg,
  .barra:has(.menu[open]) .scorciatoie a {
    transform: translateY(-140%);
    opacity: 0;
    transition-delay: calc(var(--r) * 40ms);
  }

  /* `justify-self` vale per gli elementi della griglia, e l'elemento è
   * questo — non `summary`, che ci sta dentro. Messo là non spostava niente e
   * lasciava la ☰ appiccicata a «Storia» invece che al bordo. */
  .menu {
    justify-self: end;
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -0.35rem;
    cursor: pointer;
    border-radius: var(--raggio);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Il nome accessibile del pulsante deve dire cosa fa *adesso*: un
   * `aria-label` fisso resterebbe «Apri il menu» anche a menu aperto. Le due
   * etichette sono testo vero, nascoste alla vista e non al lettore di
   * schermo; `display: none` toglie dal calcolo del nome quella che non vale
   * in questo stato, quindi ne resta sempre esattamente una. */
  .etichetta {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .menu:not([open]) .chiudi,
  .menu[open] .apri {
    display: none;
  }

  .barre {
    display: grid;
    gap: 4px;
    width: 20px;
  }
  .barre i {
    display: block;
    height: 2px;
    background: var(--inchiostro);
    transition: transform 1.1s var(--espo);
  }
  /* Le tre righe distano 6px da centro a centro: ±6px le sovrappone, e da lì
   * ruotano. Quella di mezzo si accorcia a niente invece di sparire, così la
   * × si scrive invece di apparire. */
  .menu[open] .barre i:nth-child(1) {
    transform: translateY(6px) rotate(-45deg) scaleX(0.86);
    transition-delay: 0.05s;
  }
  .menu[open] .barre i:nth-child(2) {
    transform: scaleX(0);
  }
  .menu[open] .barre i:nth-child(3) {
    transform: translateY(-6px) rotate(45deg) scaleX(0.86);
    transition-delay: 0.05s;
  }

  /* La tendina resta figlia di <details>: è lui a portare stato, tastiera e
   * annuncio «compresso/espanso» senza una riga di JavaScript. Il browser
   * però la tiene fuori dal rendering finché è chiusa, e da lì un'animazione
   * non può partire: `content-visibility: visible` gliela restituisce, e a
   * nasconderla pensano `visibility` e le righe a 0fr qui sotto. Dove
   * `::details-content` non esiste la tendina appare secca, senza
   * scorrimento: degrada, non si rompe. */
  .menu::details-content {
    content-visibility: visible;
  }
  .tendina {
    position: absolute;
    inset: 100% 0 auto 0;
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    background: var(--carta);
    border-bottom: 1px solid var(--filetto);
    box-shadow: var(--ombra-2);
    /* `visibility` cambia di scatto, ma ritardata a fine corsa: toglie le
     * voci dal giro dei Tab e dal lettore di schermo *dopo* che il foglio si
     * è richiuso, invece di farle sparire a metà chiusura. */
    transition:
      grid-template-rows 0.9s var(--espo),
      visibility 0s linear 0.9s;
  }
  .menu[open] .tendina {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.9s var(--espo),
      visibility 0s;
  }
  .rullo {
    overflow: hidden;
  }

  /* Il respiro verticale sta sulla scala del sito: 1rem sopra e sotto ogni
   * voce, gli stessi che il body tiene ai lati. Una riga arriva così sui
   * 68px — un bersaglio che il pollice non sbaglia — e la tendina è più alta,
   * che è quello che deve essere: è l'unica cosa sullo schermo mentre la
   * guardi. Sopra e sotto l'elenco mezzo passo, così il primo e l'ultimo
   * bersaglio non finiscono incollati ai bordi. */
  .tendina ol {
    counter-reset: voce;
    list-style: none;
    margin: 0;
    padding: var(--spazio-1) 0;
  }
  .tendina li a {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: var(--spazio-2);
    text-decoration: none;
    color: var(--inchiostro);
  }
  /* I numeri non stanno nel markup: sono un contatore. Rinumerare le voci
   * vuol dire riordinare l'elenco e nient'altro. */
  .tendina li a::before {
    counter-increment: voce;
    content: '0' counter(voce);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--inchiostro-muto);
    opacity: 0.5;
  }
  /* Il ritaglio fascia la riga di testo, non il collegamento. Sul
   * collegamento seguirebbe il padding: crescere il respiro scoprirebbe la
   * parola da ferma, che è come nasceva questo cambio. Così la parola parte
   * appena sotto il proprio bordo, qualunque respiro le si dia intorno. */
  .finestra {
    display: block;
    overflow: hidden;
  }
  .parola {
    display: block;
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1.18;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transform: translateY(120%);
    transition: transform 0.8s var(--espo);
  }
  .menu[open] .parola {
    transform: translateY(0);
    transition-delay: calc(var(--r) * 50ms);
  }
  .tendina a[aria-current='page'] .parola {
    color: var(--ambra);
  }

  .filetto {
    height: 1px;
    margin: var(--spazio-1) var(--spazio-2);
    background-image: repeating-linear-gradient(
      to right,
      var(--inchiostro) 0 2px,
      transparent 2px 8px
    );
    opacity: 0.35;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s var(--espo);
  }
  .menu[open] .filetto {
    transform: scaleX(1);
    transition-delay: 0.15s;
  }

  .coda {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spazio-2);
    padding: var(--spazio-2);
    transform: translateX(-300%);
    transition: transform 1.1s var(--quint);
  }
  .menu[open] .coda {
    transform: translateX(0);
    transition-delay: 0.2s;
  }
  .colofone {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
  }

  .velo {
    position: fixed;
    inset: 0;
    z-index: 19;
    background: rgb(10 12 16 / 0.5);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease-in-out,
      visibility 0s linear 0.3s;
  }
  body:has(.menu[open]) .velo {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease-in-out,
      visibility 0s;
  }

  /* Su schermi alti e larghi le voci possono respirare di più: è lo stesso
   * tendina, non un secondo menu. */
  @media (min-width: 901px) {
    .tendina ol {
      padding-block: var(--spazio-2);
    }
    .parola {
      font-size: 2.4rem;
    }
    .tendina li a,
    .filetto,
    .coda {
      margin-inline: auto;
      max-width: 46rem;
      width: 100%;
    }
  }
</style>
