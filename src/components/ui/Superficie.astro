---
/** Il contenitore non marca l'argomento, marca l'unità ripetibile con cui
 *  interagisci: una carta di attacco, un incantesimo, una capacità. Una
 *  sezione non è mai una Superficie — quello era il riquadro di prima, ed è
 *  la cosa che il ridisegno toglie.
 *
 *  'appoggiata' = unità ripetibile, 'sollevata' = blocco d'azione,
 *  'incassata' = incavo, per ciò che sta *dentro* un'altra superficie. */
interface Props {
  livello?: 'appoggiata' | 'sollevata' | 'incassata';
  class?: string;
}
const { livello = 'appoggiata', class: classe } = Astro.props;
---

<div class:list={['superficie', `livello-${livello}`, classe]}>
  <slot />
</div>

<style>
  .superficie {
    border-radius: var(--raggio-superficie);
    padding: var(--spazio-3);
  }

  /* Il nome del livello non porta più il numero dell'ombra: la mappa vive
   * solo qui. 'incassata' non ne prende nessuna — è l'unico membro senza
   * ombra, il motivo per cui "numero del livello = numero dell'ombra" si è
   * abbandonato come sistema di nomi. */
  .livello-appoggiata {
    background: var(--superficie);
    border: 1px solid var(--filetto);
    box-shadow: var(--ombra-1);
  }

  .livello-sollevata {
    background: var(--superficie);
    border: 1px solid var(--filetto);
    box-shadow: var(--ombra-2);
  }

  .livello-incassata {
    background: var(--superficie-incassata);
    border: 1px solid transparent;
  }
</style>
