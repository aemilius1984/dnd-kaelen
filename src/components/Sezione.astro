---
interface Props {
  titolo: string;
  aperta?: boolean;
}
const { titolo, aperta = false } = Astro.props;
---

<details class="pannello" open={aperta}>
  <summary><h2>{titolo}</h2></summary>
  <slot />
</details>

<style>
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '▸';
    color: var(--bronzo);
  }
  details[open] summary::before {
    content: '▾';
  }
</style>
