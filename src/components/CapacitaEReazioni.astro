---
import type { Personaggio } from '@/lib/schema';
import { fondiCapacita, testoRecupero } from '@/lib/capacita';
import Superficie from '@/components/ui/Superficie.astro';
import NomeDoppio from '@/components/ui/NomeDoppio.astro';

/** Una card per capacità, con il suo contatore addosso.
 *
 *  Prima Ira della Tempesta e Tuono della Tempesta esistevano due volte: una
 *  riga di caselle in «Slot e risorse» e una riga di innesco in «Reazioni»,
 *  senza niente che dicesse che erano la stessa cosa. Il numero di usi e la
 *  condizione che li consuma si guardano nello stesso istante.
 *
 *  Una risorsa può elencare dentro le cose che compra: Incanalare Divinità ha
 *  i suoi tre usi. Stavano in `pg.capacita` col titolo prefissato dal nome
 *  della risorsa, e il legame fra le due cose era uno `startsWith` — cioè
 *  viveva in una stringa, e si spezzava rinominando la risorsa. */
interface Props {
  pg: Personaggio;
}
const { pg } = Astro.props;

const capacita = fondiCapacita(pg);

const usiPerRisorsa = new Map(pg.risorse.filter((r) => r.usi).map((r) => [r.id, r.usi!]));
---

<div class="capacita-reazioni">
  {
    capacita.map((c) => (
      <Superficie class="capacita-card">
        <div class="testa">
          <h3 class="titolo">
            <NomeDoppio it={c.nome} en={c.nomeEn} />
          </h3>
          {c.max !== undefined && (
            <div class="contatore">
              {/* Le caselle le disegna l'isola `Contatori` per portale: qui c'è
                  solo il posto dove andranno, e il numero che si legge anche
                  senza JavaScript. */}
              <div data-caselle={c.id} />
              <span class="recupero tenue">
                {c.max} · {c.recupero && testoRecupero(c.recupero)}
              </span>
            </div>
          )}
        </div>

        {c.descrizione && <p class="descrizione">{c.descrizione}</p>}

        {c.innesco && (
          <dl class="innesco">
            <dt>Quando</dt>
            <dd>{c.innesco}</dd>
            <dt>Effetto</dt>
            <dd>{c.effetto}</dd>
          </dl>
        )}

        {c.id !== undefined && usiPerRisorsa.has(c.id) && (
          <ul class="usi">
            {usiPerRisorsa.get(c.id)!.map((u) => (
              <li>
                <strong>
                  <NomeDoppio it={u.nome} en={u.nomeEn} />
                </strong>
                {u.paragrafi.map((p) => (
                  <p>{p}</p>
                ))}
              </li>
            ))}
          </ul>
        )}
      </Superficie>
    ))
  }
</div>

<style>
  .capacita-reazioni {
    display: grid;
    gap: var(--spazio-2);
  }

  /* La riga va a capo. Il contatore di Incanalare Divinità porta la frase di
   * recupero per esteso — «2 · +1 / Riposo Breve · tutti / Riposo Lungo» —
   * che a 390px è più larga della riga intera: tenuta su una riga sola
   * spingeva la pagina a 498px, e con lei il viewport e la modale della
   * Vitalità. A capo sta comoda sotto il titolo. */
  .testa {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spazio-2);
  }

  .titolo {
    margin: 0;
    font-size: var(--fs-h3);
  }

  /* `flex: none` gli impediva sia di restringersi sia di andare a capo: la
   * frase di recupero usciva dallo schermo invece di adattarsi. Ora cede
   * quando lo spazio manca, e `min-width: 0` glielo permette davvero — senza,
   * un elemento flex non scende sotto la propria dimensione minima di
   * contenuto e la stringa lunga lo terrebbe largo lo stesso. */
  .contatore {
    flex: 0 1 auto;
    min-width: 0;
    display: grid;
    justify-items: end;
    gap: 0.15rem;
  }

  .recupero {
    font-family: var(--font-mono);
    font-size: var(--fs-piccolo);
  }

  .descrizione {
    margin: var(--spazio-2) 0 0;
    font-size: 0.92rem;
  }

  /* Innesco ed effetto sono due domande diverse — «quando scatta» e «cosa fa»
   * — e in una frase sola si leggono male al tavolo, dove si cerca la prima
   * per decidere e la seconda per applicare. */
  .innesco {
    margin: var(--spazio-2) 0 0;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.25rem 0.6rem;
    font-size: 0.9rem;
  }

  .innesco dt {
    font-family: var(--font-display);
    color: var(--inchiostro-tenue);
  }

  .innesco dd {
    margin: 0;
  }

  .usi {
    margin: var(--spazio-2) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--spazio-2);
  }

  .usi li {
    padding-top: var(--spazio-2);
    border-top: 1px solid var(--filetto);
  }

  .usi p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }
</style>
