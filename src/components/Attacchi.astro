---
import type { Personaggio } from '@/lib/schema';
import {
  cdContrasto,
  classeArmatura,
  dannoTesto,
  perColpire,
  scomposizioneColpire,
  segno,
} from '@/lib/derive';
import Superficie from '@/components/ui/Superficie.astro';
import NomeDoppio from '@/components/ui/NomeDoppio.astro';

/** Una carta per *arma*, non per attacco. Il maglio a una mano e a due mani
 *  sono lo stesso oggetto impugnato in due modi: due carte lo dicevano due
 *  volte, e la conseguenza che conta — lo scudo, quindi la CA — restava fuori
 *  da entrambe.
 *
 *  Sulla carta resta il minimo che serve nell'istante in cui tiri: nome,
 *  numero, danno. Tutto il resto si apre. */
interface Props {
  pg: Personaggio;
}
const { pg } = Astro.props;

type Attacco = Personaggio['attacchi'][number];

/** I modi che condividono `gruppo` sono un'arma sola. Chi non ha `gruppo` è
 *  un'arma di un modo solo, e il selettore non compare. */
const gruppi: { id: string; modi: Attacco[] }[] = [];
for (const a of pg.attacchi) {
  const id = a.gruppo ?? a.id;
  const gia = gruppi.find((g) => g.id === id);
  if (gia) gia.modi.push(a);
  else gruppi.push({ id, modi: [a] });
}

const cd = cdContrasto(pg);

/* Le scelte di una carta sono i suoi modi *più* le sue alternative, in una
 * fila sola: al tavolo «due mani» e «afferra» sono la stessa domanda — cosa
 * faccio con questo. Le alternative non tirano per colpire, quindi al posto
 * del totale portano la CD. */
const carte = gruppi.map(({ id, modi }) => ({
  id,
  capo: modi[0],
  gittata: modi[0].gittata,
  proprieta: modi[0].proprieta,
  parti: scomposizioneColpire(pg, modi[0].id),
  avvertenze: modi.flatMap((a) => a.avvertenze),
  scelte: [
    ...modi.map((a) => ({
      chiave: a.id,
      etichetta: a.modo ?? a.nome,
      numero: segno(perColpire(pg, a.id)),
      danno: dannoTesto(pg, a.id),
      tipoDanno: a.tipoDanno,
      ca: a.scudo === undefined ? null : classeArmatura(pg, a.scudo),
      descrizione: a.descrizione,
      nota: a.note ?? null,
      ts: null as string | null,
      limite: null as string | null,
    })),
    ...modi.flatMap((a) =>
      a.alternative.map((x) => ({
        chiave: `${a.id}-${x.nomeEn.toLowerCase()}`,
        etichetta: x.nome.toLowerCase(),
        numero: `CD ${cd}`,
        danno: null,
        tipoDanno: null,
        ca: null,
        descrizione: x.effetto,
        nota: null,
        ts: x.ts,
        limite: x.limite ?? null,
      })),
    ),
  ],
}));
---

<div class="attacchi">
  {
    carte.map((c) => (
      <Superficie class="arma">
        <button type="button" class="apri-arma" data-apre={`arma-${c.id}`}>
          <span class="nomi">
            <NomeDoppio it={c.capo.nome} en={c.capo.nomeEn} />
          </span>
          {/* Un numero per scelta, e se ne vede uno solo: con «afferra»
              selezionato, un «+5» fermo lassù direbbe una cosa falsa — quella
              scelta non tira per colpire. */}
          <span class="numeri">
            {c.scelte.map((s) => (
              <span class="numero" data-per={s.chiave}>
                {s.numero}
              </span>
            ))}
          </span>
          <svg class="freccia" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 5 16 12 9 19" />
          </svg>
        </button>

        {c.scelte.length > 1 && (
          <div class="modi" role="radiogroup" aria-label={`Come usare: ${c.capo.nome}`}>
            {c.scelte.map((s, i) => (
              <label class="modo">
                <input type="radio" name={`modo-${c.id}`} value={s.chiave} checked={i === 0} />
                <span>{s.etichetta}</span>
              </label>
            ))}
          </div>
        )}

        <div class="sintesi-pila">
          {c.scelte.map((s) => (
            <p class="sintesi" data-per={s.chiave}>
              {s.danno ? (
                <>
                  <span class="danno">{s.danno}</span>
                  <span class="tipo">{s.tipoDanno}</span>
                </>
              ) : (
                <span class="tipo">{s.ts}</span>
              )}
              {s.ca !== null && <span class="conseguenza">CA {s.ca}</span>}
            </p>
          ))}
        </div>
      </Superficie>
    ))
  }
</div>

{
  carte.map((c) => (
    <dialog class="arma-piena" id={`arma-${c.id}`} aria-label={c.capo.nome}>
      <div class="testa">
        <span class="kicker">Arma</span>
        <button type="button" class="chiudi" data-chiude aria-label="Chiudi">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
      </div>

      <div class="intestazione">
        <div class="chi">
          <h3>{c.capo.nome}</h3>
          <p class="riferimenti">{[c.capo.nomeEn, c.gittata, ...c.proprieta].join(' · ')}</p>
        </div>
        {/* Il tiro si legge in tre modi perché servono in tre momenti: il
            totale quando tiri, `1d20+N` quando lo detti a chi tira per te, la
            scomposizione quando il DM chiede se la competenza è già contata. */}
        <div class="tiro">
          <span class="totale">{segno(perColpire(pg, c.capo.id))}</span>
          <span class="dado">1d20{segno(perColpire(pg, c.capo.id))}</span>
          <span class="parti">
            {c.parti.map((p) => `${p.etichetta} ${segno(p.valore)}`).join(' · ')}
          </span>
        </div>
      </div>

      {/* Due impugnature della stessa arma e due azioni diverse non sono la
          stessa domanda: il titolo lo dice. */}
      <p class="kicker sezione">
        {c.scelte.some((s) => s.ts !== null) ? 'Cosa puoi farci' : 'Come la impugni'}
      </p>

      <div class="scelte">
        {c.scelte.map((s, i) => (
          <div class:list={['scelta', i === 0 && 'prima']}>
            <div class="capo">
              <span class="kicker">{s.etichetta}</span>
              <span class="valore">{s.danno ?? s.numero}</span>
            </div>
            {s.ts && <p class="ts">Tiro salvezza: {s.ts}.</p>}
            <p class="effetto">{s.descrizione}</p>
            {s.nota && <p class="effetto">{s.nota}</p>}
            {s.ca !== null && (
              <p class="effetto">
                Classe Armatura <strong>{s.ca}</strong>.
              </p>
            )}
            {s.limite && <p class="limite">{s.limite}</p>}
          </div>
        ))}
      </div>

      {c.avvertenze.length > 0 && (
        <>
          <p class="kicker sezione">Da sapere</p>
          <div class="avvertenze">
            {c.avvertenze.map((t) => (
              <p>{t}</p>
            ))}
          </div>
        </>
      )}
    </dialog>
  ))
}

<script>
  /* La sola riga di JavaScript di questa sezione, e concessa apposta: il
   * contenuto delle modali è tutto statico e il selettore dei modi è CSS puro.
   * `showModal()` è quel che porta trappola del focus, Escape e sfondo inerte —
   * cose che una modale fatta con `:target` non ha. */
  for (const bottone of document.querySelectorAll('[data-apre]')) {
    const finestra = document.getElementById((bottone as HTMLElement).dataset.apre ?? '');
    if (finestra instanceof HTMLDialogElement) {
      bottone.addEventListener('click', () => finestra.showModal());
    }
  }
  for (const chiudi of document.querySelectorAll('[data-chiude]')) {
    chiudi.addEventListener('click', () => chiudi.closest('dialog')?.close());
  }
</script>

<style>
  .attacchi {
    display: grid;
    gap: var(--spazio-2);
  }

  .arma {
    display: grid;
    gap: 0.7rem;
  }

  /* La riga del titolo è il bottone. Il selettore non può starci dentro — un
   * <button> non contiene controlli — e due bottoni per la stessa azione
   * sarebbero due fermate di tabulazione per la stessa destinazione. */
  .apri-arma {
    display: flex;
    align-items: center;
    gap: var(--spazio-2);
    min-height: 44px;
    padding: 0;
    background: none;
    border: none;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }

  .nomi {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--fs-h3);
  }

  .numeri {
    flex: none;
  }

  .numero {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--lampo);
  }

  .freccia {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--inchiostro-muto);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Il selettore è fatto di radio vere, nascoste alla vista e non alla
   * tastiera: frecce e lettura dello stato le porta il browser. Zero
   * JavaScript, e la scelta non sopravvive al ricaricamento — deliberato: la
   * scheda non prova a dedurre cosa Kaelen stia impugnando, lo dice e basta. */
  .modi {
    display: flex;
    border: 1px solid var(--filetto);
    border-radius: var(--raggio);
    overflow: hidden;
  }

  .modo {
    flex: 1 1 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--inchiostro-muto);
    cursor: pointer;
  }

  .modo + .modo {
    border-left: 1px solid var(--filetto);
  }

  .modo input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .modo:has(input:checked) {
    background: var(--lampo-fondo);
    color: var(--lampo);
  }

  /* Il fuoco della tastiera sta sulla radio, che non si vede: senza questo
   * chi tabula non sa mai dove si trova. */
  .modo:has(input:focus-visible) {
    outline: 2px solid var(--lampo);
    outline-offset: -2px;
  }

  .sintesi {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .danno {
    font-family: var(--font-mono);
    font-size: 1.05rem;
  }

  .tipo {
    font-size: 0.85rem;
    color: var(--inchiostro-tenue);
  }

  .conseguenza {
    font-family: var(--font-mono);
    font-size: var(--fs-piccolo);
    color: var(--inchiostro-muto);
  }

  .conseguenza::before {
    content: '· ';
  }

  /* Si vede solo la scelta selezionata, numero e sintesi insieme. Le regole
   * sono per indice perché il CSS non sa contare fin dove serve: quattro
   * coprono ogni arma di Kaelen con margine, e
   * `src/components/__tests__/attacchi.test.ts` lo verifica contro i dati. */
  .numero,
  .sintesi {
    display: none;
  }

  .arma:not(:has(.modi)) .numero:nth-child(1),
  .arma:has(.modo:nth-child(1) input:checked) .numero:nth-child(1),
  .arma:has(.modo:nth-child(2) input:checked) .numero:nth-child(2),
  .arma:has(.modo:nth-child(3) input:checked) .numero:nth-child(3),
  .arma:has(.modo:nth-child(4) input:checked) .numero:nth-child(4) {
    display: block;
  }

  .arma:not(:has(.modi)) .sintesi:nth-child(1),
  .arma:has(.modo:nth-child(1) input:checked) .sintesi:nth-child(1),
  .arma:has(.modo:nth-child(2) input:checked) .sintesi:nth-child(2),
  .arma:has(.modo:nth-child(3) input:checked) .sintesi:nth-child(3),
  .arma:has(.modo:nth-child(4) input:checked) .sintesi:nth-child(4) {
    display: flex;
  }

  /* La modale. `display` sta solo su `[open]`: il browser tiene chiuso un
   * <dialog> con `display: none` nel proprio foglio, e dichiararlo sulla
   * regola base lo scavalca — tutta la modale finirebbe dentro la pagina. È
   * già successo una volta con la Vitalità. */
  dialog.arma-piena {
    overflow-y: auto;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--spazio-2) var(--spazio-2) calc(1.2rem + env(safe-area-inset-bottom));
    border: none;
    background: var(--carta);
    color: var(--inchiostro);
  }

  dialog.arma-piena[open] {
    display: flex;
    flex-direction: column;
  }

  dialog.arma-piena::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .testa {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }

  .chiudi {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: -0.6rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .chiudi svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--inchiostro);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .intestazione {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spazio-2);
    padding: 0.4rem 0 var(--spazio-2);
  }

  .chi h3 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .riferimenti {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-piccolo);
    color: var(--inchiostro-muto);
  }

  .tiro {
    flex: none;
    text-align: right;
  }

  .totale {
    display: block;
    font-family: var(--font-mono);
    font-size: 2.2rem;
    line-height: 0.95;
    color: var(--lampo);
  }

  .dado,
  .parti {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--inchiostro-muto);
  }

  .sezione {
    margin: 0;
    padding: var(--spazio-2) 0 0.7rem;
    border-top: 1px solid var(--filetto);
  }

  .scelte {
    display: grid;
    gap: 0.7rem;
  }

  /* Ogni scelta è un blocco coi suoi numeri e la sua conseguenza: è quel che
   * separa questa modale da una scheda tecnica. La prima è quella normale, e
   * si vede che lo è. */
  .scelta {
    padding: 0.9rem var(--spazio-2);
    background: var(--superficie);
    border: 1px solid var(--filetto);
    border-radius: var(--raggio);
  }

  .scelta.prima {
    border-color: var(--lampo);
  }

  .capo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spazio-2);
  }

  .scelta.prima .capo .kicker {
    color: var(--lampo);
  }

  .valore {
    font-family: var(--font-mono);
    font-size: 1.25rem;
  }

  .scelta .ts,
  .scelta .effetto,
  .scelta .limite {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--inchiostro-tenue);
  }

  .scelta .limite {
    color: var(--inchiostro-muto);
    font-size: 0.85rem;
  }

  .avvertenze {
    display: grid;
    gap: 0.7rem;
  }

  .avvertenze p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--inchiostro-tenue);
  }
</style>
