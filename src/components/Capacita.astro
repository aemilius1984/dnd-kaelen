---
import type { Personaggio } from '@/lib/schema';

/** L'elenco lungo delle capacità, per la pagina del Personaggio: qui si legge
 *  fuori dal tavolo, quindi c'è tutto e non c'è niente da spendere.
 *
 *  Gli usi delle risorse rientrano da qui. Vivevano in `capacita` come voci
 *  col titolo prefissato, e portarli dentro la risorsa che li paga li avrebbe
 *  tolti a questa pagina in silenzio: la Scheda avrebbe continuato a
 *  mostrarli, e nessuno si sarebbe accorto del buco per due sessioni. */
interface Props {
  pg: Personaggio;
}
const { pg } = Astro.props;

const dagliUsi = pg.risorse.flatMap((r) =>
  (r.usi ?? []).map((u) => ({ titolo: `${r.nome}: ${u.nome}`, paragrafi: u.paragrafi })),
);
const voci = [...pg.capacita, ...dagliUsi];
---

{
  voci.map((c) => (
    <section class="capacita">
      <h3>{c.titolo}</h3>
      {c.paragrafi.map((p) => (
        <p>{p}</p>
      ))}
    </section>
  ))
}

<style>
  .capacita {
    border-top: 1px solid var(--filetto);
    padding-top: 0.6rem;
  }
  h3 {
    margin: 0.4rem 0 0.2rem;
    font-size: 0.98rem;
  }
  p {
    margin: 0.25rem 0;
    font-size: 0.92rem;
  }
</style>
