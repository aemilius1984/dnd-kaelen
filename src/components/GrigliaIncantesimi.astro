---
import type { Incantesimo } from '@/lib/schema';
import { simbolo } from '@/lib/sigilli';

// Dipendenza: la pagina ospite deve montare `Sprite.astro`, una volta sola e
// prima di questa griglia. I sigilli sono `<use href="#sig-…">` e senza il
// foglio di simboli restano riquadri vuoti, senza alcun errore che lo dica.

interface Props {
  incantesimi: (Incantesimo & { slug: string; testo: string })[];
  titolo: string;
  /** Se presente, ogni blocco porta `data-slug` e parte nascosto (attributo
   *  `hidden` scritto qui, a tempo di build) a meno che lo slug non sia in
   *  questo elenco: così i 32 incantesimi del pool sono tutti presenti in
   *  HTML statico, ma solo i preparati sono visibili al primo caricamento,
   *  senza attendere JavaScript. L'isola ControlliLancio corregge poi la
   *  visibilità se lo stato salvato in sessione si è discostato da questo
   *  elenco iniziale (scambio di preparati dopo un Riposo Lungo). Quando
   *  omesso il blocco è sempre visibile. */
  visibiliDiDefault?: string[];
}
const { incantesimi, titolo, visibiliDiDefault } = Astro.props;
---

<h3 class="titolo-griglia">{titolo}</h3>
<div class="griglia">
  {
    incantesimi.map((m) => (
      <details
        class="sigillo"
        data-slug={visibiliDiDefault ? m.slug : undefined}
        hidden={visibiliDiDefault ? !visibiliDiDefault.includes(m.slug) : undefined}
      >
        <summary>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <use href={`#${simbolo(m.slug, m.tag)}`} />
          </svg>
          <span class="nome">{m.nome}</span>
          <span class="livello">{m.livello === 0 ? 'T' : m.livello}</span>
        </summary>
        <div class="carta">
          <p class="meta tenue">
            {m.lancio} · {m.gittata} · {m.componenti}
            {m.concentrazione && ' · concentrazione'}
            {m.tiro && ` · TS ${m.tiro}`}
            {m.danno && ` · ${m.danno}`}
          </p>
          <p>{m.testo}</p>
          {m.slotSuperiore && <p class="tenue">Slot superiore: {m.slotSuperiore}</p>}
          <div class="lancio" data-lancio={m.slug} data-livello={m.livello} />
        </div>
      </details>
    ))
  }
</div>
