---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import mobile from '@/assets/kaelen-splash-mobile.webp';
import desktop from '@/assets/kaelen-splash-desktop.webp';

const voce = await getEntry('character', 'kaelen');
if (!voce) throw new Error('Scheda di Kaelen non trovata');
const pg = voce.data;

// Art direction vera: due immagini diverse, non due ritagli della stessa.
// <Picture> non copre questo caso, quindi il <picture> è scritto a mano.
const mob = await getImage({ src: mobile, format: 'webp' });
const desk = await getImage({ src: desktop, format: 'webp' });
---

<BaseLayout titolo="Kaelen" attiva={null}>
  <div class="splash" id="splash">
    <picture>
      <source media="(min-width: 901px)" srcset={desk.src} />
      <img
        src={mob.src}
        width={1170}
        height={2532}
        alt="Kaelen sulla prua di una nave durante una tempesta notturna"
        fetchpriority="high"
      />
    </picture>

    <div class="lampo" aria-hidden="true"></div>

    <div class="porte">
      <p class="nome">{pg.nome}</p>
      <p class="qualifica">{pg.specie} · {pg.classe} {pg.livello} · {pg.sottoclasse}</p>
      <nav>
        <a href="/scheda/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#sig-maglio"></use></svg>
          Scheda
        </a>
        <a href="/storia/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#sig-amuleto"></use></svg>
          Storia
        </a>
      </nav>
    </div>
  </div>

  <svg class="sprite" aria-hidden="true" focusable="false">
    <symbol id="sig-maglio" viewBox="0 0 24 24">
      <path
        d="M12 21V11M8.5 11h7M7 4.5h10v4H7zM9.5 4.5v4M14.5 4.5v4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </symbol>
    <symbol id="sig-amuleto" viewBox="0 0 24 24">
      <path
        d="M12 3v3M12 21a7 7 0 100-14 7 7 0 000 14zM9.5 10.5l5 5M14.5 10.5l-5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </symbol>
  </svg>

  <script is:inline>
    // Tre comportamenti che il CSS non copre: mostrare l'animazione una sola
    // volta al giorno, saltarla al primo tocco, ricordare che è stata vista.
    (function () {
      const splash = document.getElementById('splash');
      const oggi = new Date().toISOString().slice(0, 10);
      let vista;
      try {
        vista = localStorage.getItem('kaelen:splash');
      } catch {
        vista = null;
      }
      if (vista === oggi) splash.classList.add('finita');
      else {
        try {
          localStorage.setItem('kaelen:splash', oggi);
        } catch {
          /* storage negato: si rivedrà, non è un danno */
        }
      }
      splash.addEventListener('pointerdown', function () {
        splash.classList.add('finita');
      });
    })();
  </script>
</BaseLayout>

<style>
  .splash {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--carta);
  }
  .splash img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    animation: deriva 12s ease-out forwards;
  }
  @keyframes deriva {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .lampo {
    position: absolute;
    inset: 0;
    background: #cfe3f2;
    opacity: 0;
    mix-blend-mode: screen;
    animation: lampo 9s ease-out 1.6s 2;
  }
  @keyframes lampo {
    0%,
    100% {
      opacity: 0;
    }
    2% {
      opacity: 0.5;
    }
    5% {
      opacity: 0.05;
    }
    7% {
      opacity: 0.35;
    }
    12% {
      opacity: 0;
    }
  }

  /* Il velo di pioggia — righe diagonali chiare in scorrimento perpetuo — è
     stato tolto: sul ritratto peggiorava la fotografia invece di ambientarla,
     e da quando la grana di `base.css` copre l'intera pagina il ritratto
     portava due texture sovrapposte. Il lampo resta: agisce sulla luce, non
     sul dettaglio dell'immagine. */

  .porte {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0 var(--spazio-2) calc(2rem + env(safe-area-inset-bottom));
    text-align: center;
    opacity: 0;
    animation: entra 1s ease-out 1.2s forwards;
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .nome {
    font-family: var(--font-display);
    font-size: 2.6rem;
    letter-spacing: 0.06em;
    margin: 0;
    color: #f2ece0;
  }
  .qualifica {
    margin: 0.1rem 0 1.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b9c3cf;
  }
  .porte nav {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
  }
  .porte a {
    flex: 1 1 0;
    max-width: 11rem;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.7rem 0.5rem;
    border: 1px solid rgb(226 162 74 / 0.55);
    border-radius: var(--raggio);
    background: rgb(10 12 16 / 0.55);
    color: #f2ece0;
    text-decoration: none;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
  }
  .porte svg {
    width: 26px;
    height: 26px;
    color: var(--oro);
  }

  /* Salto: qualunque tocco, o la seconda apertura della giornata, portano
   * tutto allo stato finale senza attese. */
  .splash.finita img,
  .splash.finita .lampo,
  .splash.finita .porte {
    animation: none;
  }
  .splash.finita .porte {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash img,
    .splash .lampo,
    .splash .porte {
      animation: none;
    }
    .splash .porte {
      opacity: 1;
    }
  }

  /* Desktop: la figura sta al centro-destra e il terzo sinistro è cielo
   * vuoto. Nome e porte vanno lì, non in basso. */
  @media (min-width: 901px) {
    .porte {
      inset: 0 auto 0 0;
      width: min(34vw, 26rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: left;
      padding: 0 0 0 4rem;
    }
    .porte nav {
      justify-content: flex-start;
    }
    .nome {
      font-size: 3.6rem;
    }
  }

  .sprite {
    position: absolute;
    width: 0;
    height: 0;
  }
</style>
