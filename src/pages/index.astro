---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import mobile from '@/assets/kaelen-splash-mobile.webp';
import desktop from '@/assets/kaelen-splash-desktop.webp';

const voce = await getEntry('character', 'kaelen');
if (!voce) throw new Error('Scheda di Kaelen non trovata');
const pg = voce.data;

// Art direction vera: due immagini diverse, non due ritagli della stessa.
// <Picture> non copre questo caso, quindi il <picture> è scritto a mano.
const mob = await getImage({ src: mobile, format: 'webp' });
const desk = await getImage({ src: desktop, format: 'webp' });
---

<!-- `#24282c` non è scelto a occhio: è la media delle due strisce da 40px in
cima e in fondo a `kaelen-splash-mobile.webp`, rgb(36, 40, 44) su entrambe.
Serve a far sparire la barra di Safari dentro la fotografia. Chi ritocca
l'immagine deve rimisurarla, altrimenti questo numero resta indietro. -->
<BaseLayout titolo="Kaelen" attiva={null} coloreTema="#24282c">
  <div class="splash" id="splash">
    <picture>
      <source media="(min-width: 901px)" srcset={desk.src} />
      <img
        src={mob.src}
        width={1170}
        height={2532}
        alt="Kaelen sulla prua di una nave durante una tempesta notturna"
        fetchpriority="high"
      />
    </picture>

    <div class="lampo" aria-hidden="true"></div>

    <div class="porte">
      <p class="nome">{pg.nome}</p>
      <p class="qualifica">{pg.specie} · {pg.classe} {pg.livello} · {pg.sottoclasse}</p>
      <nav>
        <a href="/scheda/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#sig-maglio"></use></svg>
          Scheda
        </a>
        <a href="/storia/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#sig-amuleto"></use></svg>
          Storia
        </a>
      </nav>
    </div>
  </div>

  <svg class="sprite" aria-hidden="true" focusable="false">
    <symbol id="sig-maglio" viewBox="0 0 24 24">
      <path
        d="M12 21V11M8.5 11h7M7 4.5h10v4H7zM9.5 4.5v4M14.5 4.5v4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </symbol>
    <symbol id="sig-amuleto" viewBox="0 0 24 24">
      <path
        d="M12 3v3M12 21a7 7 0 100-14 7 7 0 000 14zM9.5 10.5l5 5M14.5 10.5l-5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </symbol>
  </svg>

  <script is:inline>
    // Tre comportamenti che il CSS non copre: mostrare l'animazione d'ingresso
    // una sola volta al giorno, saltarla al primo tocco, ricordare che è stata
    // vista. Il lampo non passa di qui: è CSS puro, in loop, sempre acceso.
    (function () {
      const splash = document.getElementById('splash');
      const oggi = new Date().toISOString().slice(0, 10);
      let vista;
      try {
        vista = localStorage.getItem('kaelen:splash');
      } catch {
        vista = null;
      }
      if (vista === oggi) splash.classList.add('finita');
      else {
        try {
          localStorage.setItem('kaelen:splash', oggi);
        } catch {
          /* storage negato: si rivedrà, non è un danno */
        }
      }
      splash.addEventListener('pointerdown', function () {
        splash.classList.add('finita');
      });
    })();
  </script>
</BaseLayout>

<style>
  /* Due altezze, non una. Su iOS Safari la barra dell'URL si ritira mentre si
     scorre, e il browser espone i due stati come misure diverse: `lvh` è la
     pagina a barra ritirata, `svh` a barra distesa. La fotografia prende la
     grande, così sotto la barra c'è immagine e non fondo.

     `100vh` prima e `100lvh` dopo non è ridondanza da potare: su iOS `100vh`
     vale già l'altezza grande, quindi è il ripiego esatto — e dove `lvh` non
     arriva la riga si scarta da sola lasciando in piedi quella sopra. */
  .splash {
    position: fixed;
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    background: var(--carta);
  }
  .splash img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    animation: deriva 12s ease-out forwards;
  }
  @keyframes deriva {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  /* Il temporale non si esaurisce mentre la pagina è aperta: due colpi e poi
     più nulla lasciavano una fotografia ferma, e chi tornava sulla home nella
     stessa giornata non vedeva niente del tutto — la regola di salto spegneva
     anche questo. Ora è un ciclo infinito: ogni caricamento della home lo fa
     ripartire da capo, su desktop come su mobile.

     Le quattro scariche stanno a distanze irregolari dentro lo stesso giro di
     24s — 4,6s, 2,9s, 6,2s, 5,5s — perché un colpo solo per ciclo si sente
     come un metronomo. La prima cade a 1,6s, insieme alle porte. */
  .lampo {
    position: absolute;
    inset: 0;
    background: #cfe3f2;
    opacity: 0;
    mix-blend-mode: screen;
    animation: lampo 24s ease-out 1.6s infinite;
  }
  @keyframes lampo {
    /* prima scarica: doppio colpo */
    0% {
      opacity: 0;
    }
    0.8% {
      opacity: 0.5;
    }
    2% {
      opacity: 0.05;
    }
    3% {
      opacity: 0.35;
    }
    5% {
      opacity: 0;
    }
    /* seconda: un colpo solo, più debole */
    24% {
      opacity: 0;
    }
    24.8% {
      opacity: 0.32;
    }
    29% {
      opacity: 0;
    }
    /* terza: la più vicina e la più forte */
    41% {
      opacity: 0;
    }
    41.8% {
      opacity: 0.55;
    }
    43% {
      opacity: 0.08;
    }
    44% {
      opacity: 0.4;
    }
    46% {
      opacity: 0;
    }
    /* quarta, dopo la pausa lunga */
    72% {
      opacity: 0;
    }
    72.8% {
      opacity: 0.4;
    }
    74% {
      opacity: 0.06;
    }
    75% {
      opacity: 0.28;
    }
    77% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /* Il velo di pioggia — righe diagonali chiare in scorrimento perpetuo — è
     stato tolto: sul ritratto peggiorava la fotografia invece di ambientarla,
     e da quando la grana di `base.css` copre l'intera pagina il ritratto
     portava due texture sovrapposte. Il lampo resta: agisce sulla luce, non
     sul dettaglio dell'immagine. */

  /* Le porte, al contrario dell'immagine, si misurano sull'altezza piccola:
     `fixed` con `bottom: 0` su iOS Safari sta sopra la barra dell'URL, non
     sotto, quindi i due comandi non ci finiscono mai dietro. Installata come
     PWA la barra non c'è e le due altezze coincidono: le porte scendono da
     sole al bordo dello schermo, senza una regola dedicata.

     Il ripiego dentro `env()` non è ornamento: senza, su un browser che non
     popola la zona sicura l'intero `calc()` diventa non valido e le porte
     perdono lo scarto in fondo invece di averlo a zero. */
  .porte {
    position: fixed;
    inset: auto 0 0 0;
    padding: 0 var(--spazio-2) calc(2rem + env(safe-area-inset-bottom, 0px));
    text-align: center;
    opacity: 0;
    animation: entra 1s ease-out 1.2s forwards;
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .nome {
    font-family: var(--font-display);
    font-size: 2.6rem;
    letter-spacing: 0.06em;
    margin: 0;
    color: #f2ece0;
  }
  .qualifica {
    margin: 0.1rem 0 1.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b9c3cf;
  }
  .porte nav {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
  }
  .porte a {
    flex: 1 1 0;
    max-width: 11rem;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.7rem 0.5rem;
    border: 1px solid rgb(226 162 74 / 0.55);
    border-radius: var(--raggio);
    background: rgb(10 12 16 / 0.55);
    color: #f2ece0;
    text-decoration: none;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
  }
  .porte svg {
    width: 26px;
    height: 26px;
    color: var(--oro);
  }

  /* Salto: qualunque tocco, o la seconda apertura della giornata, portano
   * l'ingresso allo stato finale senza attese. Il lampo non è ingresso ed è
   * fuori da questa regola: è l'ambiente della scena e non finisce mai. */
  .splash.finita img,
  .splash.finita .porte {
    animation: none;
  }
  .splash.finita .porte {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash img,
    .splash .lampo,
    .splash .porte {
      animation: none;
    }
    .splash .porte {
      opacity: 1;
    }
  }

  /* Desktop: la figura sta al centro-destra e il terzo sinistro è cielo
   * vuoto. Nome e porte vanno lì, non in basso. */
  @media (min-width: 901px) {
    .porte {
      inset: 0 auto 0 0;
      width: min(34vw, 26rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: left;
      padding: 0 0 0 4rem;
    }
    .porte nav {
      justify-content: flex-start;
    }
    .nome {
      font-size: 3.6rem;
    }
  }

  .sprite {
    position: absolute;
    width: 0;
    height: 0;
  }
</style>
