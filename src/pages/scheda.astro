---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Attacchi from '@/components/Attacchi.astro';
import GrigliaIncantesimi from '@/components/GrigliaIncantesimi.astro';
import Sprite from '@/components/Sprite.astro';
import DatiIniziali from '@/components/DatiIniziali.astro';
import PfTracker from '@/islands/PfTracker';
import Risorse from '@/islands/Risorse';
import ControlliLancio from '@/islands/ControlliLancio';
import PannelloAzioni from '@/islands/PannelloAzioni';
import type { Personaggio } from '@/lib/schema';
import { attaccoIncantesimi, cdIncantesimi, classeArmatura, iniziativa, segno } from '@/lib/derive';
import { campiVersione, hashDati } from '@/lib/sheet-version';
import ritrattoSrc from '@/assets/kaelen-home.webp';

const ritratto = await getImage({ src: ritrattoSrc, format: 'webp', width: 80 });

const voce = await getEntry('character', 'kaelen');
if (!voce) throw new Error('Scheda di Kaelen non trovata');

// `reference()` trasforma gli slug in oggetti { id, collection }. Li riportiamo a
// stringhe: così questo oggetto combacia con il tipo `Personaggio` usato da derive,
// dai componenti e dallo stato di sessione, e ne esiste una sola forma in tutto il sito.
const dati = voce.data;
const pg: Personaggio = {
  ...dati,
  trucchetti: dati.trucchetti.map((r) => r.id),
  preparatiIniziali: dati.preparatiIniziali.map((r) => r.id),
  dominio: dati.dominio.map((r) => r.id),
};

const tutte = await getCollection('spells');
const perSlug = new Map(tutte.map((m) => [m.id, m]));
const conTesto = (slug: string) => {
  const m = perSlug.get(slug);
  if (!m) throw new Error(`Incantesimo mancante: ${slug}`);
  return { ...m.data, slug, testo: (m.body ?? '').trim() };
};

const trucchetti = pg.trucchetti.map(conTesto);
const dominio = pg.dominio.map(conTesto);

const pool = tutte
  .map((m) => ({ slug: m.id, nome: m.data.nome, livello: m.data.livello, dominio: m.data.dominio }))
  .filter((m) => m.livello > 0 && !m.dominio)
  .sort((a, b) => a.livello - b.livello || a.nome.localeCompare(b.nome, 'it'));

// Il testo completo di TUTTI gli incantesimi del pool, non solo dei sei
// preparati all'avvio: dopo uno scambio a fine Riposo Lungo il giocatore deve
// vedere tempo di lancio, gittata, TS e danno anche del nuovo incantesimo, non
// solo il nome. Sono tutti presenti in HTML in build; ControlliLancio
// mostra/nasconde in base allo stato.
const preparatiPool = pool.map((m) => conTesto(m.slug));

// `pg` è già normalizzato a slug stringa nel Task 6: è la stessa forma che le isole
// ricevono nel blocco JSON, quindi l'hash è stabile fra build identiche. Hash solo
// sui campi da cui `StatoSessione` dipende (vedi campiVersione): correggere un
// refuso nelle capacità o nelle reazioni non deve azzerare la sessione salvata.
const sheetVersion = hashDati(JSON.stringify(campiVersione(pg, pool)));

const ca = classeArmatura(pg);
const cd = cdIncantesimi(pg);
const bonusIncantesimi = segno(attaccoIncantesimi(pg));
const bonusIniziativa = segno(iniziativa(pg));
---

<BaseLayout titolo="Kaelen — Scheda" attiva="scheda">
  <Sprite />
  <DatiIniziali pg={pg} sheetVersion={sheetVersion} pool={pool} />

  <header class="identita">
    <img src={ritratto.src} width="40" height="40" alt="" class="avatar" />
    <div>
      <p class="nome">{pg.nome}</p>
      <p class="tenue qualifica">{pg.classe} {pg.livello} · {pg.sottoclasse}</p>
    </div>
  </header>

  <div class="pannello pf-pannello">
    <PfTracker client:only="preact" />
  </div>

  <div class="difese">
    <div><span class="tenue">CA</span><span class="valore">{ca}</span></div>
    <div><span class="tenue">CD</span><span class="valore">{cd}</span></div>
    <div><span class="tenue">INIZ</span><span class="valore">{bonusIniziativa}</span></div>
  </div>

  <section class="pannello">
    <h2>Attacchi</h2>
    <Attacchi pg={pg} />
  </section>

  <section class="pannello">
    <h2>Incantesimi</h2>
    <p class="tenue attacco-inc">Attacco {bonusIncantesimi} · CD {cd}</p>
    <GrigliaIncantesimi titolo="Trucchetti" incantesimi={trucchetti} />
    <GrigliaIncantesimi
      titolo="Preparati"
      incantesimi={preparatiPool}
      visibiliDiDefault={pg.preparatiIniziali}
    />
    <GrigliaIncantesimi titolo="Dominio" incantesimi={dominio} />
    <p class="tenue">
      <a href="/preparati/">Cambia i preparati</a>
    </p>
  </section>

  <section class="pannello">
    <h2>Slot e risorse</h2>
    <Risorse client:only="preact" />
  </section>

  <section class="pannello">
    <h2>Reazioni: scegline una</h2>
    <table>
      <thead><tr><th>Reazione</th><th>Innesco</th><th>Effetto</th></tr></thead>
      <tbody>
        {
          pg.reazioni.map((r) => (
            <tr>
              <td>{r.nome}</td>
              <td class="tenue">{r.innesco}</td>
              <td>{r.effetto}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <nav class="altrove">
    <a href="/personaggio/">Personaggio</a>
    <a href="/note/">Note di sessione</a>
  </nav>

  <ControlliLancio client:only="preact" />
  <PannelloAzioni client:only="preact" />
</BaseLayout>
