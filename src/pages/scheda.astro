---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Attacchi from '@/components/Attacchi.astro';
import CarteIncantesimo from '@/components/CarteIncantesimo.astro';
import Sprite from '@/components/Sprite.astro';
import DatiIniziali from '@/components/DatiIniziali.astro';
import Superficie from '@/components/ui/Superficie.astro';
import TestaSezione from '@/components/ui/TestaSezione.astro';
import CapacitaEReazioni from '@/components/CapacitaEReazioni.astro';
import PfTracker from '@/islands/PfTracker';
import SlotIncantesimi from '@/islands/SlotIncantesimi';
import Contatori from '@/islands/Contatori';
import ControlliLancio from '@/islands/ControlliLancio';
import Ispirazione from '@/islands/Ispirazione';
import PannelloAzioni from '@/islands/PannelloAzioni';
import { attaccoIncantesimi, cdIncantesimi, classeArmatura, iniziativa, segno } from '@/lib/derive';
import { caricaScheda } from '@/lib/carica-scheda';
import ritrattoSrc from '@/assets/kaelen-home.webp';

const ritratto = await getImage({ src: ritrattoSrc, format: 'webp', width: 80 });

const { pg, pool, sheetVersion } = await caricaScheda();

// Il testo completo degli incantesimi non viaggia nel pool condiviso: solo
// questa pagina lo mostra (trucchetti, dominio e l'intero pool dei preparati),
// quindi resta qui invece di entrare in `caricaScheda`.
const tutte = await getCollection('spells');
const perSlug = new Map(tutte.map((m) => [m.id, m]));
const conTesto = (slug: string) => {
  const m = perSlug.get(slug);
  if (!m) throw new Error(`Incantesimo mancante: ${slug}`);
  return { ...m.data, slug, testo: (m.body ?? '').trim() };
};

const trucchetti = pg.trucchetti.map(conTesto);
const dominio = pg.dominio.map(conTesto);

// Il testo completo di TUTTI gli incantesimi del pool, non solo dei sei
// preparati all'avvio: dopo uno scambio a fine Riposo Lungo il giocatore deve
// vedere tempo di lancio, gittata, TS e danno anche del nuovo incantesimo, non
// solo il nome. Sono tutti presenti in HTML in build; ControlliLancio
// mostra/nasconde in base allo stato.
const preparatiPool = pool.map((m) => conTesto(m.slug));

const ca = classeArmatura(pg);
const cd = cdIncantesimi(pg);
const bonusIncantesimi = segno(attaccoIncantesimi(pg));
const bonusIniziativa = segno(iniziativa(pg));
---

<BaseLayout titolo="Kaelen — Scheda" attiva="scheda">
  <Sprite />
  <DatiIniziali pg={pg} sheetVersion={sheetVersion} pool={pool} />

  <header class="identita">
    <img src={ritratto.src} width="40" height="40" alt="" class="avatar" />
    <div>
      <h1 class="nome">{pg.nome}</h1>
      <p class="tenue qualifica">{pg.classe} {pg.livello} · {pg.sottoclasse}</p>
    </div>
  </header>

  <Superficie livello="sollevata" class="pf-pannello">
    <PfTracker client:only="preact" />
  </Superficie>

  <div class="difese">
    <div><span class="tenue">CA</span><span class="valore">{ca}</span></div>
    <div><span class="tenue">CD</span><span class="valore">{cd}</span></div>
    <div><span class="tenue">INIZ</span><span class="valore">{bonusIniziativa}</span></div>
    {
      /* L'unico valore della fascia che dipende dallo stato di sessione, quindi
        l'unico che arriva dopo l'idratazione: l'altezza è riservata dal CSS
        della fascia, che è la stessa per tutte e quattro le colonne. */
    }
    <Ispirazione client:only="preact" />
  </div>

  <section>
    <TestaSezione kicker="in combattimento">Attacchi</TestaSezione>
    <Attacchi pg={pg} />
  </section>

  <section>
    <TestaSezione kicker="magia">Incantesimi</TestaSezione>
    <p class="tenue attacco-inc">Attacco {bonusIncantesimi} · CD {cd}</p>

    {
      /* Due aree, perché obbediscono a regole diverse: i trucchetti non
        consumano nulla e non si spengono mai; gli altri sì. */
    }
    <TestaSezione as="h3">Trucchetti</TestaSezione>
    <CarteIncantesimo incantesimi={trucchetti} />

    <TestaSezione as="h3">Incantesimi</TestaSezione>
    <CarteIncantesimo incantesimi={preparatiPool} visibiliDiDefault={pg.preparatiIniziali} />
    <CarteIncantesimo incantesimi={dominio} />

    <p class="tenue">
      <a href="/preparati/">Cambia i preparati</a>
    </p>
  </section>

  <section>
    <TestaSezione kicker="quel che si consuma">Slot incantesimo</TestaSezione>
    <div class="risorse-isola">
      <SlotIncantesimi client:only="preact" />
    </div>
  </section>

  {
    /* I contatori delle risorse non stanno più qui: sono dentro le card
      sottostanti, accanto alla capacità che li consuma. */
  }
  <section>
    <TestaSezione kicker="cosa puoi spendere">Capacità e reazioni</TestaSezione>
    <p class="tenue attacco-inc">Dopo una reazione non puoi usarne un'altra fino al tuo turno.</p>
    <CapacitaEReazioni pg={pg} />
  </section>

  <nav class="altrove">
    <a href="/personaggio/">Personaggio</a>
    <a href="/note/">Note di sessione</a>
  </nav>

  <ControlliLancio client:only="preact" />
  <Contatori client:only="preact" />
  <PannelloAzioni client:only="preact" />
</BaseLayout>
