---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sezione from '@/components/Sezione.astro';

const capitoli = (await getCollection('background')).sort((a, b) => a.data.ordine - b.data.ordine);
const resi = await Promise.all(
  capitoli.map(async (c) => ({ titolo: c.data.titolo, Content: (await render(c)).Content })),
);
---

<BaseLayout titolo="Kaelen — Storia" attiva="storia">
  <h1>Storia</h1>
  {
    resi.map(({ titolo, Content }) => (
      <Sezione titolo={titolo}>
        <Content />
      </Sezione>
    ))
  }
</BaseLayout>
