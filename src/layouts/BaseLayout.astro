---
import TabBar from '@/components/TabBar.astro';
import '@/styles/tokens.css';

interface Props {
  titolo: string;
  attiva: 'scheda' | 'tattiche' | 'background';
}
const { titolo, attiva } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Deve girare prima del primo rendering, quindi non può importare
      // src/lib/tema.ts: la regola è duplicata a mano. Vedi il commento in
      // risolviTema().
      (function () {
        let salvato = null;
        try {
          salvato = localStorage.getItem('kaelen:tema');
        } catch {
          // storage negato o non disponibile: resta il valore nullo già impostato
        }
        const chiaro = window.matchMedia('(prefers-color-scheme: light)').matches;
        const tema =
          salvato === 'tempesta' || salvato === 'pergamena'
            ? salvato
            : chiaro
              ? 'pergamena'
              : 'tempesta';
        document.documentElement.dataset.tema = tema;
      })();
    </script>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0c10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe7d6" media="(prefers-color-scheme: light)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{titolo}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <TabBar attiva={attiva} />
    <script is:inline>
      if (
        'serviceWorker' in navigator &&
        (location.protocol === 'https:' || location.hostname === 'localhost')
      ) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
