---
import Menu from '@/components/Menu.astro';
import RegistraServiceWorker from '@/components/RegistraServiceWorker.astro';
import AvvisoAzzeramento from '@/islands/AvvisoAzzeramento';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/componenti.css';

interface Props {
  titolo: string;
  attiva: 'scheda' | 'personaggio' | 'storia' | 'preparati' | 'note' | null;
  /** Colore della barra del browser, per le rotte che non sono di pergamena. */
  coloreTema?: string;
}
const { titolo, attiva, coloreTema = '#efe7d6' } = Astro.props;
---

<!doctype html>
<html lang="it" data-tema="pergamena">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Un tema solo, scritto su <html> in build: nessuno script deve
      correggere il colore prima del primo paint, e questo meta non può
      contraddire una scelta dell'utente che non esiste più. Vedi BACKLOG.md
      per il tema scuro futuro.

      Il colore però non è più uno per tutto il sito. Cinque rotte sono carta e
      prendono il ripiego; la home è una fotografia notturna, e la barra di
      Safari deve sparire dentro la fotografia invece di tagliarla con una
      striscia chiara. Navigando dalla home alle altre rotte il colore
      lampeggia: è il prezzo, ed è accettato, perché quel lampeggio dura un
      caricamento mentre la striscia sulla splash resterebbe lì per sempre. -->
    <meta name="theme-color" content={coloreTema} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{titolo}</title>
  </head>
  <body>
    {attiva !== null && <Menu attiva={attiva} />}
    <main>
      {
        /* `assicuraInizializzato()` alza l'avviso su tutte le pagine che
        incorporano DatiIniziali, non solo sulla Scheda: l'avviso deve poter
        comparire su tutte, altrimenti un azzeramento incassato su /note/ è
        silenzioso e va perso alla prima `muta()`. Le due rotte escluse sono
        esattamente quelle senza il blocco `#dati-iniziali`: la splash, che non
        mostra il menu e ha `attiva` null, e la Storia, che non ha isole
        proprie. */
        attiva !== null && attiva !== 'storia' && <AvvisoAzzeramento client:only="preact" />
      }
      <slot />
    </main>
    {
      /* Aprire e chiudere un `<dialog>` non è stato: sono due chiamate al DOM.
      Un'isola qui monterebbe Preact per due `addEventListener`, e il bottone
      resterebbe morto finché non si idrata. Poche righe inline lo fanno
      funzionare appena il markup esiste.

      Sta nel layout, e non nei componenti, perché di modali ne hanno tre —
      archivio, armi, incantesimi — e ognuno si era portato la propria copia.
      Il selettore è globale: tre copie volevano dire tre ascoltatori su ogni
      bottone e tre `showModal()` per ogni click. Non dava errore, perché un
      dialogo già modale ignora la seconda chiamata; l'avrebbe dato il giorno
      in cui uno di quei bottoni avesse commutato invece di aprire. */
    }
    <script is:inline>
      for (const b of document.querySelectorAll('[data-apre]')) {
        b.addEventListener('click', () => document.getElementById(b.dataset.apre)?.showModal());
      }
      /* `data-chiude` non porta un id: il bottone che chiude sta sempre dentro
      il dialogo che chiude, e farglielo nominare era un secondo posto dove
      sbagliare a scriverlo. */
      for (const b of document.querySelectorAll('[data-chiude]')) {
        b.addEventListener('click', () => b.closest('dialog')?.close());
      }
    </script>
    {
      /* Il service worker non è un sorgente: lo scrive scripts/build-sw.mjs
      dentro dist/ dopo `astro build`. Sotto `astro dev` non esiste e non può
      esistere, quindi registrarlo lì sarebbe solo una 404 per ogni pagina
      aperta. `npm run preview` serve la build, dove PROD è vero: la PWA resta
      verificabile in locale, che è l'unico posto dove ha senso verificarla. */
      import.meta.env.PROD && <RegistraServiceWorker />
    }
  </body>
</html>
