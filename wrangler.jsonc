{
  // Questo file serve **solo allo sviluppo locale**: dice a `wrangler pages
  // dev` quale D1 collegare al binding `DB`.
  //
  // Non c'è `pages_build_output_dir`, e non deve esserci. Quella chiave
  // trasformerebbe questo file nella fonte di verità del progetto Pages: la
  // dashboard smetterebbe di poter configurare binding e variabili, e un
  // deploy porterebbe in produzione una configurazione scritta per lo
  // sviluppo — dove ci sono anche `SITE_USER` e `SITE_PASS`. La configurazione
  // vera dei due ambienti sta sulla dashboard.
  //
  // **Il binding si chiama `DB` in tutti e due gli ambienti.** Cambia il
  // database dietro, mai il nome davanti: `wrangler d1 create` suggerisce come
  // binding il nome del database, e prendere quel suggerimento alla lettera
  // darebbe `kaelen` in Production e `kaelen_preview` in Preview, costringendo
  // la funzione a indovinare in quale ambiente sta girando.
  //
  //   Production  kaelen           a90cff0d-ef6e-4bb0-9ece-b14cb955b5f4
  //   Preview     kaelen-preview   c269bb09-519a-49aa-b6c1-10509d990bf8
  //
  // Due database e non uno perché la potatura tiene venti salvataggi: con un
  // database solo, un pomeriggio di prove dal ramo può buttare fuori una
  // sessione di gioco vera.
  "name": "dnd-kaelen",
  "compatibility_date": "2026-08-19",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaelen",
      "database_id": "a90cff0d-ef6e-4bb0-9ece-b14cb955b5f4",
      // L'id vero di `kaelen-preview`, non un segnaposto. In locale
      // `wrangler` non tocca comunque il database remoto: crea e usa un
      // SQLite sotto `.wrangler/`, e questo valore gli serve solo per
      // accettare il binding. Scriverci l'id vero costa niente e rende
      // raggiungibile il Preview con `--remote --preview`, che è l'unico
      // modo di applicargli una migrazione: `d1 migrations apply` risolve
      // il nome contro questo file, e `kaelen-preview` qui non c'è.
      "preview_database_id": "c269bb09-519a-49aa-b6c1-10509d990bf8",
    },
  ],
}
